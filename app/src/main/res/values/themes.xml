<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2.3.0 起不再透壁纸：原版那种「窗口透壁纸 + 滚动」在 Compose 上会出现整片重影，
         因此改成不透明纯黑背景。状态栏 / 导航栏一并黑底，避免上下出现亮条。 -->
    <style name="Theme.MyDrawer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/mydrawer_window_background</item>
        <item name="android:colorBackground">@color/mydrawer_window_background</item>
        <item name="android:statusBarColor">@color/mydrawer_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mydrawer_window_background</item>
        <item name="android:navigationBarDividerColor">@color/mydrawer_window_background</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
